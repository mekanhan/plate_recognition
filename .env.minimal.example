# Minimal .env for testing
# Copy this to .env for basic functionality

# Device Settings
DEVICE_NAME=LPR-Test-Device
DEVICE_LOCATION=Test Location

# Camera (adjust if needed)
CAMERA_ID=0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480

# Sync (offline mode for testing)
SYNC_MODE=manual
CLOUD_API_URL=https://api.lprcloud.com

# Logging
LOG_LEVEL=INFO