# Edge Device Configuration Example
# Copy this file to .env and configure for your deployment

# === DEPLOYMENT MODE ===
DEPLOYMENT_MODE=web_ui  # web_ui, headless, hybrid
ENABLE_WEB_UI=true
ENABLE_BACKGROUND_PROCESSING=false
WEB_UI_PORT=8001

# === EDGE DEVICE SETTINGS ===
DEVICE_NAME=LPR-Edge-001
DEVICE_LOCATION=Main Entrance
REGISTRATION_TOKEN=your-registration-token-here

# === CLOUD SYNC CONFIGURATION ===
CLOUD_API_URL=https://api.lprcloud.com
SYNC_MODE=batch  # immediate, batch, manual
SYNC_INTERVAL=300  # seconds (5 minutes)
SYNC_BATCH_SIZE=50
SYNC_MAX_RETRIES=3
DATA_RETENTION_DAYS=30
ENABLE_COMPRESSION=true

# === CAMERA SETTINGS ===
CAMERA_ID=0
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_FPS=30

# === MODEL CONFIGURATION ===
MODEL_PATH=app/models/yolo11m_best.pt
MODEL_CONFIDENCE=0.5
MODEL_DEVICE=auto  # auto, cpu, cuda

# === PROCESSING SETTINGS ===
CONFIDENCE_THRESHOLD=0.5
MIN_OCR_CONFIDENCE=0.3
COOLDOWN_PERIOD=5.0
STREAM_PROCESSING_FREQUENCY=5

# === STORAGE PATHS ===
LICENSE_PLATES_DIR=data/license_plates
ENHANCED_PLATES_DIR=data/enhanced_plates
SOURCE_IMAGES_DIR=data/source_images
SAVE_FULL_IMAGES=true
IMAGE_QUALITY=85

# === LOGGING ===
LOG_LEVEL=INFO
ENABLE_PERFORMANCE_LOGGING=true
LOG_FILE=logs/app.log

# === DATABASE ===
DATABASE_URL=sqlite+aiosqlite:///data/license_plates.db
ENABLE_DATABASE_BACKUP=true

# === SECURITY ===
ENABLE_CORS=true
REQUIRE_API_KEY=false

# === PERFORMANCE ===
MAX_CONCURRENT_DETECTIONS=5
ENABLE_GPU_ACCELERATION=true