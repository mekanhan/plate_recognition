# LPR System Environment Configuration
# Copy this file to .env and customize for your environment

# =============================================================================
# Database Configuration
# =============================================================================
LPR_DB_PATH=data/license_plates.db
LPR_DB_BACKUP_DIR=data/backups
LPR_DB_POOL_SIZE=5
LPR_DB_POOL_TIMEOUT=30
LPR_DB_CONNECTION_TIMEOUT=10
LPR_DB_FOREIGN_KEYS=true

# =============================================================================
# Logging Configuration  
# =============================================================================
LPR_LOG_DIR=logs
LPR_LOG_MAX_SIZE_MB=10
LPR_LOG_MAX_FILES=5
LPR_LOG_RETENTION_DAYS=7
LPR_LOG_DISK_THRESHOLD=0.85
LPR_LOG_LEVEL=INFO

# =============================================================================
# Storage Configuration
# =============================================================================
LPR_RECORDINGS_DIR=recordings
LPR_DETECTIONS_DIR=detections
LPR_MODELS_DIR=ai_pipeline/models
LPR_TEMP_DIR=temp

# Retention policies (in days/hours)
LPR_RECORDING_RETENTION_DAYS=30
LPR_DETECTION_RETENTION_DAYS=14
LPR_TEMP_RETENTION_HOURS=24

# Storage limits (in GB)
LPR_MAX_STORAGE_GB=100.0
LPR_MAX_RECORDING_GB=80.0
LPR_MAX_DETECTION_GB=15.0

# Cleanup thresholds (0.0 to 1.0)
LPR_STORAGE_CLEANUP_THRESHOLD=0.90
LPR_EMERGENCY_CLEANUP_THRESHOLD=0.95

# =============================================================================
# Service Configuration
# =============================================================================
LPR_MAIN_API_PORT=8001
LPR_RECORDING_API_PORT=8002
LPR_FRONTEND_PORT=8080

# Service timeouts (in seconds)
LPR_STARTUP_TIMEOUT=30
LPR_HEALTH_TIMEOUT=5
LPR_SHUTDOWN_TIMEOUT=10

# Health monitoring
LPR_HEALTH_INTERVAL=30
LPR_HEALTH_RETRIES=3

# =============================================================================
# Security Configuration
# =============================================================================
# IMPORTANT: Generate a secure random key for production!
# You can use: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
LPR_JWT_SECRET_KEY=your-super-secure-secret-key-here

LPR_JWT_ALGORITHM=HS256
LPR_JWT_EXPIRATION_HOURS=24

# CORS settings
LPR_ENABLE_CORS=true
LPR_ALLOWED_ORIGINS=*

# API security
LPR_API_RATE_LIMIT=100/minute

# Data encryption
LPR_ENCRYPT_CREDENTIALS=true
LPR_ENCRYPTION_KEY_FILE=config/.encryption_key

# =============================================================================
# AI/ML Configuration
# =============================================================================
LPR_YOLO_MODEL_PATH=ai_pipeline/models/yolo11m_best.pt
LPR_OCR_LANGUAGES=en

# Detection thresholds (0.0 to 1.0)
LPR_DETECTION_CONFIDENCE=0.5
LPR_OCR_CONFIDENCE=0.7

# Processing settings
LPR_MAX_DETECTION_AGE=300
LPR_ENABLE_GPU=true
LPR_MAX_WORKERS=2
LPR_BATCH_SIZE=1

# =============================================================================
# Development/Debug Settings
# =============================================================================
# Uncomment for development
# LPR_LOG_LEVEL=DEBUG
# LPR_ENABLE_GPU=false

# =============================================================================
# Production Settings
# =============================================================================
# For production deployment, consider:
# LPR_LOG_LEVEL=WARNING
# LPR_LOG_RETENTION_DAYS=3
# LPR_ENCRYPT_CREDENTIALS=true
# LPR_ALLOWED_ORIGINS=https://yourdomain.com