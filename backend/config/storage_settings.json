{
  "storage": {
    "base_storage_path": "recordings",
    "retention_days": 30,
    "hot_storage_days": 7,
    "warm_storage_days": 23,
    "max_storage_gb_per_camera": 1000,
    "warning_threshold_percent": 75,
    "critical_threshold_percent": 85,
    "cleanup_interval_hours": 1,
    "monitoring_interval_minutes": 30,
    "uncompressed_size_multiplier": 10,
    "enable_compression_scheduling": true
  },
  "video": {
    "segment_duration_seconds": 600,
    "buffer_size_frames": 300,
    "codec_preference": ["RAW ", "I420", "YUV ", null, "FFV1", "H264", "MJPG", "XVID", "mp4v"],
    "enable_audio": false,
    "uncompressed_mode": true,
    "quality_settings": {
      "low": {
        "width": 320,
        "height": 240,
        "fps": 15
      },
      "medium": {
        "width": 640,
        "height": 480,
        "fps": 30
      },
      "high": {
        "width": 1280,
        "height": 720,
        "fps": 30
      },
      "uncompressed": {
        "width": null,
        "height": null,
        "fps": 30,
        "pixel_format": "raw",
        "note": "Uses original camera resolution without compression"
      }
    }
  },
  "compression": {
    "enabled": true,
    "compress_warm_storage": true,
    "compress_after_days": 7,
    "target_compression_ratio": 0.3,
    "compression_codec": "H264",
    "compression_quality": "high"
  },
  "comments": {
    "uncompressed_mode": "Prioritizes uncompressed codecs for maximum quality",
    "codec_preference": "Order of codec preference - uncompressed first, then compressed fallbacks",
    "uncompressed_size_multiplier": "Estimated size increase for uncompressed vs compressed video",
    "enable_compression_scheduling": "Automatically compress older recordings to save space",
    "max_storage_gb_per_camera": "Increased to 1TB per camera to accommodate uncompressed video"
  }
}