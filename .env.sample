# LPR System Configuration Sample
# Copy this file to .env and customize for your deployment

# Deployment Configuration
DEPLOYMENT_MODE=web_ui
ENABLE_WEB_UI=true
ENABLE_BACKGROUND_PROCESSING=false

# Camera Settings
CAMERA_ID=0
CAMERA_WIDTH=1920
CAMERA_HEIGHT=1080
CAMERA_FPS=60

# Model Configuration
MODEL_PATH=ai_pipeline/train/models/pretrained/yolo11m_best.pt
MODEL_DEVICE=auto
ENABLE_GPU_ACCELERATION=true

# Detection Parameters
CONFIDENCE_THRESHOLD=0.5
MIN_OCR_CONFIDENCE=0.3
COOLDOWN_PERIOD=5.0
MATCH_THRESHOLD=0.8

# Storage Paths
LICENSE_PLATES_DIR=data/license_plates
ENHANCED_PLATES_DIR=data/enhanced_plates
KNOWN_PLATES_PATH=data/known_plates.json

# Processing Settings
BACKGROUND_FRAME_SKIP=5
BACKGROUND_PROCESSING_INTERVAL=0.5
BACKGROUND_MAX_QUEUE_SIZE=100
BACKGROUND_HEALTH_CHECK_INTERVAL=30.0
MAX_CONCURRENT_DETECTIONS=5
MAX_FRAME_BUFFER_SIZE=30
BATCH_SIZE=10
PROCESS_INTERVAL=0.5
STREAM_PROCESSING_FREQUENCY=3

# Output Configuration
ENABLE_STORAGE_OUTPUT=true
ENABLE_API_OUTPUT=true
ENABLE_WEBSOCKET_OUTPUT=false
ENABLE_WEBHOOK_OUTPUT=false

# Web Interface
WEB_UI_PORT=8001

# Processing Mode
BACKGROUND_PROCESSING_MODE=interval
BACKGROUND_BATCH_SIZE=10

# Monitoring
ENABLE_BACKGROUND_METRICS=true
LOG_LEVEL=INFO
ENABLE_PERFORMANCE_LOGGING=true

# Database Settings
USE_KNOWN_PLATES_DB=true

# Authentication Settings
JWT_SECRET_KEY=your-super-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-secure-admin-password

# Database Configuration
DATABASE_URL=sqlite+aiosqlite:///data/license_plates.db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=30

# API Server Settings
API_HOST=localhost
API_PORT=8001
API_RELOAD=false
API_LOG_LEVEL=info

# Recording Service Settings
RECORDING_API_PORT=8002
RECORDING_ENABLED=true
RECORDING_SEGMENT_DURATION=600
RECORDING_STORAGE_LIMIT_GB=10
RECORDING_CLEANUP_THRESHOLD=0.90

# Frontend Settings  
FRONTEND_PORT=8080
FRONTEND_HOST=localhost

# Monitoring & Metrics
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
METRICS_EXPORT_INTERVAL=10
HEALTH_CHECK_INTERVAL=30
ENABLE_SYSTEM_MONITORING=true

# Analytics Settings
ANALYTICS_ENABLED=true
ANALYTICS_DATA_RETENTION_DAYS=90
ANALYTICS_CHART_CACHE_TTL=300

# Storage Management
STORAGE_LIMIT_GB=50
STORAGE_CLEANUP_ENABLED=true
STORAGE_CLEANUP_THRESHOLD=0.85
DEDUPLICATION_ENABLED=true
DEDUPLICATION_COOLDOWN_MINUTES=30

# Security Settings
CORS_ORIGINS=["http://localhost:8080","http://localhost:3000"]
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Development Settings (set to false in production)
DEBUG=false
ENABLE_SWAGGER_UI=true
LOG_SQL_QUERIES=false